---
import type { CollectionEntry } from "astro:content";
import { CalendarDays, ExternalLink } from "lucide-react";
import BaseHead from "../components/BaseHead.astro";
import HomeShell from "../components/HomeShell.astro";
import MarkdownContent from "../components/MarkdownContent.astro";

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { title, description, pubDate, video, link } = project.data;
const formattedDate = pubDate.toLocaleDateString("en-US", {
  month: "short",
  day: "numeric",
  year: "numeric",
  timeZone: "UTC",
});
const poster = `/project-thumbnails/${project.id}.jpg`;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <BaseHead title={title} description={description} image={poster} />
  </head>

  <body>
    <HomeShell>
      <article class="project-post">
        <div class="project-post__inner">
          <header class="project-post__header">
            <p class="project-post__label">Project</p>

            <div class="project-post__meta">
              <span class="project-post__date">
                <CalendarDays size={18} strokeWidth={1.7} aria-hidden="true" />
                <time datetime={pubDate.toISOString()}>{formattedDate}</time>
              </span>
            </div>

            <h1>
              <a href={link} target="_blank" rel="noopener noreferrer">
                <span>{title}</span>
                <ExternalLink
                  className="project-post__external-icon"
                  size={31}
                  strokeWidth={1.45}
                  aria-hidden="true"
                />
                <span class="sr-only">(opens in a new tab)</span>
              </a>
            </h1>
            <p class="project-post__description">{description}.</p>
          </header>

          <div class="project-post__media">
            <video
              src={video}
              poster={poster}
              autoplay
              loop
              muted
              playsinline
              aria-label={`${title} project demonstration`}
            ></video>
          </div>

          <div class="project-post__body">
            <MarkdownContent>
              <slot />
            </MarkdownContent>
          </div>
        </div>
      </article>
    </HomeShell>
  </body>
</html>

<style>
  .project-post {
    min-height: 100vh;
    background:
      radial-gradient(circle at 74% 18%, rgb(167 43 72 / 2.5%), transparent 31%),
      hsl(28 25% 98.5%);
    color: hsl(var(--foreground));
    padding: 3.5rem 1.25rem 5rem;
    font-family: var(--font-body);
  }

  .project-post__inner {
    width: min(100%, 60rem);
    margin: 0 auto;
  }

  .project-post__header {
    max-width: 52rem;
  }

  .project-post__label {
    width: fit-content;
    margin: 0;
    color: hsl(var(--brand));
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.055em;
    line-height: 1;
    text-transform: uppercase;
  }

  .project-post__label::after {
    display: block;
    width: 3.5rem;
    height: 0.125rem;
    margin-top: 0.75rem;
    background: hsl(var(--brand));
    content: "";
  }

  .project-post__meta {
    display: flex;
    margin-top: 1.75rem;
    align-items: center;
    gap: 1rem;
    color: hsl(var(--muted-foreground));
    font-size: 0.9375rem;
  }

  .project-post__date {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    white-space: nowrap;
  }

  .project-post h1 {
    margin: 1.5rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(3.25rem, 7vw, 5rem);
    font-weight: 400;
    letter-spacing: -0.035em;
    line-height: 0.95;
  }

  .project-post h1 a {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    color: inherit;
    text-decoration: none;
  }

  .project-post h1 a:hover {
    color: hsl(var(--brand));
  }

  .project-post h1 a:focus-visible {
    border-radius: 0.25rem;
    outline: 2px solid hsl(var(--brand));
    outline-offset: 0.4rem;
  }

  .project-post h1 :global(.project-post__external-icon) {
    flex: none;
    color: hsl(var(--muted-foreground));
    transition: color 160ms ease, transform 160ms ease;
  }

  .project-post h1 a:hover :global(.project-post__external-icon) {
    color: hsl(var(--brand));
    transform: translate(0.1rem, -0.1rem);
  }

  .project-post__description {
    margin: 1rem 0 0;
    color: hsl(var(--muted-foreground));
    font-size: clamp(1.125rem, 2.2vw, 1.35rem);
    line-height: 1.45;
  }

  .project-post__media {
    position: relative;
    overflow: hidden;
    aspect-ratio: 16 / 6.1;
    margin-top: 1.25rem;
    border: 1px solid hsl(var(--border));
    border-radius: 0.75rem;
    background: color-mix(in srgb, hsl(var(--background)) 78%, white);
    box-shadow: 0 1.25rem 3rem rgb(53 39 34 / 9%);
  }

  .project-post__media video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .project-post__body {
    margin-top: 2.25rem;
  }

  @media (max-width: 35rem) {
    .project-post h1 {
      font-size: clamp(2.8rem, 14vw, 4rem);
    }

    .project-post h1 a {
      gap: 0.65rem;
    }

    .project-post h1 :global(.project-post__external-icon) {
      width: 1.45rem;
      height: 1.45rem;
    }

    .project-post__media {
      aspect-ratio: 16 / 9;
    }
  }

  @media (min-width: 48rem) {
    .project-post {
      padding: 4.5rem 3rem 6rem;
    }
  }

  @media (min-width: 64rem) and (max-width: 79.999rem) {
    .project-post {
      padding-inline: 2.25rem;
    }
  }

  @media (min-width: 80rem) {
    .project-post {
      padding-top: 4rem;
    }
  }
</style>
