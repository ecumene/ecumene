<script>
  const prefersReducedMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)"
  );

  document.querySelectorAll(".about-page__deck").forEach((deck) => {
    if (!(deck instanceof HTMLUListElement) || deck.dataset.stackReady) return;

    const cards = Array.from(
      deck.querySelectorAll<HTMLButtonElement>("[data-flip-card]")
    );

    const setFlipped = (card: HTMLButtonElement, flipped: boolean) => {
      const front = card.querySelector(".about-page__fact-front");
      const back = card.querySelector(".about-page__fact-back");
      const title = card.querySelector("[data-card-title]")?.textContent?.trim();
      const story = card.querySelector("[data-card-story]")?.textContent?.trim();
      const caption = card.querySelector("[data-card-caption]")?.textContent?.trim();
      const video = card.querySelector("video");

      if (!(front instanceof HTMLElement) || !(back instanceof HTMLElement)) {
        return;
      }

      card.classList.toggle("is-flipped", flipped);
      card.setAttribute("aria-pressed", String(flipped));
      front.setAttribute("aria-hidden", String(flipped));
      back.setAttribute("aria-hidden", String(!flipped));
      card.setAttribute(
        "aria-label",
        flipped
          ? `${video ? "Video" : "Photo"}: ${caption} Flip to return to ${title}.`
          : `${title}. ${story} Flip to show the back of the card.`
      );

      if (!(video instanceof HTMLVideoElement)) return;

      if (flipped && !prefersReducedMotion.matches) {
        void video.play().catch(() => undefined);
      } else {
        video.pause();
        video.currentTime = 0;
      }
    };

    cards.forEach((card, index) => {
      const returnControl = card.querySelector<HTMLElement>(
        "[data-card-return]"
      );

      setFlipped(card, false);

      returnControl?.addEventListener("click", (event) => {
        event.stopPropagation();
        setFlipped(card, false);
      });

      card.addEventListener("click", () => {
        setFlipped(card, card.getAttribute("aria-pressed") !== "true");
      });

      card.addEventListener("keydown", (event) => {
        if (event.key === "Escape") {
          event.preventDefault();
          setFlipped(card, false);
          return;
        }

        if (event.key !== "ArrowLeft" && event.key !== "ArrowRight") return;

        event.preventDefault();
        const direction = event.key === "ArrowRight" ? 1 : -1;
        const nextIndex = (index + direction + cards.length) % cards.length;
        cards[nextIndex]?.focus();
      });
    });

    deck.dataset.stackReady = "true";
  });
</script>

