{
  "name": "@ecumene/ui",
  "version": "1.0.0",
  "description": "UI components for ecumene",
  "type": "module",
  "main": "./src/index.tsx",
  "exports": {
    ".": "./src/index.tsx",
    "./src": "./src/index.tsx",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "clean": "rm -rf dist",
    "build": "tsc",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "lint": "oxlint . --deny-warnings",
    "lint:fix": "oxlint . --fix",
    "package": "yarn clean && yarn build && yarn pack --out ./dist/%s-%v.tgz",
    "publish": "yarn clean && yarn build && yarn npm publish"
  },
  "dependencies": {
    "astro": "7.0.9",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@astrojs/mdx": "7.0.3",
    "@astrojs/react": "6.0.1",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.3",
    "@tsconfig/node18": "18.2.6",
    "@tsconfig/strictest": "2.0.8",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "tslib": "2.8.1",
    "typescript": "6.0.3"
  }
}
