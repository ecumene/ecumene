{
  "name": "@ecumene/ui",
  "version": "1.0.0",
  "description": "UI components for ecumene",
  "type": "module",
  "main": "./src/index.tsx",
  "exports": {
    ".": "./src/index.tsx",
    "./src": "./src/index.tsx",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "clean": "rm -rf dist",
    "build": "tsc",
    "format": "prettier --check",
    "format:fix": "prettier --write",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --max-warnings 0 --fix",
    "package": "yarn clean && yarn build && yarn pack --out ./dist/%s-%v.tgz",
    "publish": "yarn clean && yarn build && yarn npm publish"
  },
  "dependencies": {
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "astro": "7.0.9"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@astrojs/mdx": "7.0.3",
    "@astrojs/react": "6.0.1",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@eslint/js": "10.0.1",
    "@tsconfig/node18": "18.2.6",
    "@tsconfig/strictest": "2.0.8",
    "@types/node": "26.1.1",
    "@typescript-eslint/eslint-plugin": "8.64.0",
    "@typescript-eslint/parser": "8.64.0",
    "eslint": "10.7.0",
    "eslint-plugin-simple-import-sort": "13.0.0",
    "globals": "17.7.0",
    "prettier": "3.9.5",
    "tslib": "2.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.64.0"
  }
}
