# Docker must already contain this image. Use a unique release tag or digest.
OFFICE_IMAGE=wordpad-live:release

# Absolute path on the server, outside this checkout. Contains ANTHROPIC_API_KEY.
OFFICE_SECRETS_FILE=/home/ubuntu/.config/wordpad-live/app.env

# Paste the generated bcrypt hash between single quotes; preserve every "$".
# Empty/missing values prevent Compose from starting either service.
OFFICE_PASSWORD_HASH=''
