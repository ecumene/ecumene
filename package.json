{
  "name": "ecumene",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "mitchellhynes.com:build": "cd apps/mitchellhynes.com && yarn build",
    "mitchellhynes.com:start": "cd apps/mitchellhynes.com && yarn start",
    "mitchellhynes.com:dev": "cd apps/mitchellhynes.com && yarn dev",
    "mitchellhynes.com:preview": "cd apps/mitchellhynes.com && yarn preview",
    "jestersprivilege.ca:build": "cd apps/jestersprivilege.ca && yarn build",
    "jestersprivilege.ca:start": "cd apps/jestersprivilege.ca && yarn start",
    "jestersprivilege.ca:dev": "cd apps/jestersprivilege.ca && yarn dev",
    "jestersprivilege.ca:preview": "cd apps/jestersprivilege.ca && yarn preview",
    "lint": "oxlint . --deny-warnings",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0"
  },
  "packageManager": "yarn@4.17.1+sha512.ccbfabf7d7b6b32075088be9386fb9a2e00bb6887ef07fa56effabc890a56d53da1ccc4128d62db245fcbd3961b236d75335bdf7d5320ed6eafb7588b7ad4697"
}
